# Copy this file to .env and fill in your own values. Never commit .env.

# AI model key (required for the chat). The course setup uses OpenAI models through Portkey.
PORTKEY_API_KEY=your-portkey-api-key-here
# Optional fallback if you don't use Portkey: a plain OpenAI key (then set CHAT_MODEL to a model you can use).
# OPENAI_API_KEY=your-openai-api-key-here

# Optional model settings (defaults shown).
CHAT_MODEL=gpt-5.6-luna
CHAT_REASONING_EFFORT=low

# Long random string that signs login session cookies, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-to-a-long-random-string

# The course test account (test@campuscustoms.yale.edu / password) has a legacy hash with no iteration
# count; on startup it is re-hashed with Argon2id so it can log in. Set to 0 to skip.
RESET_COURSE_TEST_USER=1

# Optional: PBKDF2 iteration count of the other seeded accounts, if the course provides it.
LEGACY_PBKDF2_ITERATIONS=

# Set to 1 only when serving over HTTPS (marks the session cookie Secure).
COOKIE_SECURE=0
